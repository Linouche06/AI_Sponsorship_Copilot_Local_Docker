    {
      "parameters": {
        "jsCode": "const due=$('Pick Due Followups').all().map(x=>x.json);\nconst results=$input.all();\nreturn results.map((r,i)=>{const v=due[i]; if(!v) throw new Error('Missing source row for reminder response'); return {json:{company_key:v.company_key,company:v.company,status:v.status,next_followup:v.next_followup,notes:v.notes,owner_chat_id:v.owner_chat_id,last_contact_at:v.last_contact_at,updated_at:new Date().toISOString(),reminder_sent_for:v.next_followup}};});"
      },
