    {
      "parameters": {
        "jsCode": "const today = new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());\nconst input=$input.all().map(i=>i.json);\nconst due=input.filter(r=>r.company_key && r.next_followup && /^\\d{4}-\\d{2}-\\d{2}$/.test(String(r.next_followup)) && String(r.next_followup)<=today && String(r.reminder_sent_for||'')!==String(r.next_followup) && !['Declined','Confirmed'].includes(String(r.status||'')) && /^-?\\d+$/.test(String(r.owner_chat_id||'')));\nreturn due.slice(0,30).map(r=>({json:{...r,chat_id:String(r.owner_chat_id),reply_text:`Sponsorship follow-up due: ${r.company}\\nStatus: ${r.status||'New'}\\nDue: ${r.next_followup}${r.notes?'\\nContext: '+String(r.notes).slice(0,320):''}\\n\\nUpdate with /status ${r.company} | Contacted or /followup ${r.company} | YYYY-MM-DD`}}));"
      },
