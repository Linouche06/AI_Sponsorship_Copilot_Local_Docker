    {
      "parameters": {
        "promptType": "define",
        "text": "=Evaluate the sponsor for this demo event. EVENT: Student AI Builders Hackathon in Paris/Cergy, audience: university students building AI products, needs: technical mentors, tools, workshops and prizes. COMPANY: {{ $json.company }}; industry: {{ $json.industry }}; description: {{ $json.description }}; tags: {{ $json.tags }}; partnership ideas: {{ $json.partnership_ideas }}. Do not claim the company has agreed to sponsor. Return exactly 2 short lines: REASON: ... and OPPORTUNITIES: ... . Only use supplied company info.",
        "messages": {
          "messageValues": [
            {
              "message": "You are a cautious university sponsorship analyst. Do not invent company facts or commitments."
            }
          ]
        }
      },
      "id": "14f96144-3745-41b5-ad10-bd95e8fcb599",
      "name": "AI Sponsorship Assessment",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        816,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "model": "qwen2.5:3b",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "403ab75d-095e-474a-b981-7c0d6e6f5ae3",
      "name": "Ollama Model (Analysis)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        816,
        176
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "jsCode": "const c=$('Choose Company').first().json;\nconst ai=String($input.first().json.text||'');\nconst tags=String(c.tags||'').toLowerCase().split(',').map(x=>x.trim());\nconst tech=['ai','developers','software','cloud','models','coding','opensource','gpu','computing'];\nconst entrepreneurial=['startups','founders','entrepreneurship','students','community'];\nconst fit=Math.min(50,tags.filter(x=>tech.includes(x)).length*12);\nconst audience=Math.min(30,tags.filter(x=>entrepreneurial.includes(x)).length*10+10);\nconst activation=String(c.partnership_ideas||'').trim()?20:0;\nconst score=Math.min(100,fit+audience+activation);\nconst tier=score>=75?'High':score>=45?'Medium':'Low';\nconst reason=(ai.match(/REASON:\\s*([^\\n]+)/i)||[])[1]||'Fit based on the listed company profile.';\nconst opportunities=(ai.match(/OPPORTUNITIES:\\s*([^\\n]+)/i)||[])[1]||String(c.partnership_ideas||'Workshop or mentorship discussion');\nconst analyzed_at=new Date().toISOString();\nreturn [{json:{company_key:c.company_key,company:c.company,score,tier,reason,opportunities,analyzed_at,reply_text:`Sponsorship analysis: ${c.company}\\nFit score: ${score}/100 (${tier})\\nWhy: ${reason}\\nPotential partnership: ${opportunities}\\n\\nNext: /pitch ${c.company}`,chat_id:c.chat_id}}];"
      },
