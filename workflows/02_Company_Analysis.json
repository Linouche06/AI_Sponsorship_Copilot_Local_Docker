    {
      "parameters": {
        "jsCode": "const req=$('Sub-workflow Input').first().json;\nconst key=(req.company||'').trim().toLowerCase();\nconst rows=$input.all().map(x=>x.json);\nconst c=rows.find(r=>String(r.company||'').toLowerCase()===key || String(r.company_key||'')===key.replace(/\\s+/g,'_'));\nif(!c)return [{json:{...req,found:false,reply_text:'Company not found. Try /analyze OVHcloud or another company from the Companies tab.'}}];\nreturn [{json:{...req,...c,found:true}}];"
      },
